{
  "format": "cybercore-component-index",
  "kit_version": "1.0.0",
  "components": {
    "theme-chooser": {
      "module": "theme-chooser",
      "fallback": "native-select"
    },
    "detail-dialog": {
      "module": "detail-dialog",
      "fallback": "inline"
    },
    "install-console": {
      "module": "install-console",
      "fallback": "pre"
    }
  },
  "asset_variants": {
    "static": {
      "required": true,
      "purpose": "Reduced-motion and low-power fallback"
    },
    "mobile": {
      "required": false,
      "purpose": "Small viewport crop or layout"
    },
    "neon": {
      "required": false,
      "purpose": "Cybercore accent treatment"
    }
  },
  "element": {
    "tag": "cybercore-theme-chooser",
    "script": "chooser.js",
    "stylesheet": "chooser.css"
  }
}
